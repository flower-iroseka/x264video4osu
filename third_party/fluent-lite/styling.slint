import { ColorSchemeSelector } from "color-scheme.slint";

export struct TextStyle {
    font-size: relative-font-size,
    font-weight: int,
}

export global FluentFontSettings {
    out property <TextStyle> body-strong: { font-size: 14pt * 1rem / 14pt, font-weight: FontWeight.semi-bold };
    out property <TextStyle> title: { font-size: 28pt * 1rem / 14pt, font-weight: FontWeight.semi-bold };
}

export global FluentPalette {
    in-out property <ColorScheme> color-scheme: ColorSchemeSelector.color-scheme;
    // 自定义风格固定浅色；color-scheme 由 ColorSchemeSelector 提供（恒为 light）。
    // 双主题：is-aero=false 为「默认主题」（git 历史 HEAD 的经典 Fluent：白底、
    // #0078D4 蓝）；is-aero=true 为「Aero」主题（天蓝渐变/玻璃白/aqua 主色）。
    // is-aero 由每个窗口组件的 `apply-theme()` 函数（public）从 Rust 侧同步设置。
    // 深色分支恒不启用，保留原值。accentify() 不再需要（builtin 风格专属）。
    property <bool> dark-color-scheme: color-scheme == ColorScheme.dark;
    in-out property <bool> is-aero: false;

    // base palette
    out property <brush> background: dark-color-scheme ? #1C1C1C : (is-aero ? @linear-gradient(180deg, #8ED1F0 0%, #C8E9FA 50%, #F2FBFF 100%) : #FFFFFF);
    out property <brush> foreground: dark-color-scheme ? #FFFFFF : (is-aero ? #0E2A36 : #000000E6);
    out property <brush> alternate-background: dark-color-scheme ? #2C2C2C : (is-aero ? #E7F6FF : #F8F9FA);
    out property <brush> alternate-foreground: dark-color-scheme ? #FFFFFF : (is-aero ? #0E2A36 : #000000E6);
    out property <brush> control-background: dark-color-scheme ? #FFFFFF0F : (is-aero ? #EDF8FF : #FFFFFFB3);
    out property <brush> control-foreground: dark-color-scheme ? #FFFFFF : (is-aero ? #0E2A36 : #000000E6);
    out property <brush> accent-background: dark-color-scheme ? #60CDFF : (is-aero ? #00A8E8 : #0078D4);
    out property <brush> accent-foreground: dark-color-scheme ? #000000 : #FFFFFF;
    out property <brush> selection-background: is-aero ? #00A8E8 : #0078D4;
    out property <brush> selection-foreground: dark-color-scheme ? #000000 : #FFFFFF;
    out property <brush> border: dark-color-scheme ? #FFFFFF14 : (is-aero ? #6BB7D9 : #00000073);

    // additional palette
    out property <brush> secondary-accent-background: accent-background.with-alpha(0.9);
    out property <brush> tertiary-accent-background: accent-background.with-alpha(0.8);
    out property <brush> accent-disabled: dark-color-scheme ? #FFFFFF29 : (is-aero ? #A8CCDF : #00000038);
    out property <brush> accent-control-border: dark-color-scheme ? @linear-gradient(180deg, #FFFFFF14 90.67%, #00000024 100%) : (is-aero ? @linear-gradient(180deg, #FFFFFFB3 90.67%, #5FA9CE 100%) : @linear-gradient(180deg, #FFFFFF14 90.67%, #00000066 100%));
    out property <brush> control-border: dark-color-scheme ? @linear-gradient(180deg, #FFFFFF17 0%, #00000012 8.33%) : (is-aero ? @linear-gradient(180deg, #DFF2FC 90.58%, #9CCBE6 100%) : @linear-gradient(180deg, #0000000F 90.58%, #00000029 100%));
    out property <brush> text-accent-foreground-secondary: dark-color-scheme ? #00000080 : #FFFFFFB3;
    out property <brush> text-accent-foreground-disabled: dark-color-scheme ? #FFFFFF87 : #FFFFFF;
    out property <brush> text-secondary: dark-color-scheme ? #FFFFFFC9 : (is-aero ? #335A6E : #00000099);
    out property <brush> text-tertiary: dark-color-scheme ? #FFFFFF8A : (is-aero ? #5C7E92 : #00000073);
    out property <brush> text-disabled: dark-color-scheme ? #FFFFFF5E : (is-aero ? #93AEC0 : #0000005E);
    out property <brush> text-control-border: dark-color-scheme ? @linear-gradient(180deg, #FFFFFF14 99.98%, #FFFFFF8A 100%, #FFFFFF8A 100%) : (is-aero ? @linear-gradient(180deg, #DFF2FC 99.99%, #9CCBE6 100%, #9CCBE6 100%) : @linear-gradient(180deg, #0000000F 99.99%, #00000073 100%, #00000073 100%));
    out property <brush> control-secondary: dark-color-scheme ? #FFFFFF14 : (is-aero ? #D2ECFA : #F9F9F980);
    out property <brush> control-tertiary: dark-color-scheme ? #FFFFFF08 : (is-aero ? #BCE0F4 : #F9F9F94D);
    out property <brush> control-disabled: dark-color-scheme ? #FFFFFF0A : (is-aero ? #D9E7F0 : #F9F9F94D);
    out property <brush> control-alt-secondary: dark-color-scheme ? #0000001A : (is-aero ? #DCEFFB : #00000005);
    out property <brush> control-alt-tertiary: dark-color-scheme ? #FFFFFF0A : (is-aero ? #E8F5FD : #0000000F);
    out property <brush> control-alt-quaternary: dark-color-scheme ? #FFFFFF12 : (is-aero ? #F1FAFE : #00000017);
    out property <brush> control-alt-disabled: transparent;
    out property <brush> control-strong-stroke: dark-color-scheme ? #FFFFFF99 : (is-aero ? #4799C2 : #00000099);
    out property <brush> control-strong-stroke-disabled: dark-color-scheme ? #FFFFFF29 : (is-aero ? #A9C8D9 : #00000038);
    out property <brush> control-solid: dark-color-scheme ? #454545 : #FFFFFF;
    out property <brush> circle-border: dark-color-scheme ? @linear-gradient(180deg, #FFFFFF17 0%, #FFFFFF12 100%) : (is-aero ? @linear-gradient(180deg, #E8F6FE 0%, #9CCBE6 100%) : @linear-gradient(180deg, #0000000F 0%, #00000029 100%));
    out property <brush> control-input-active: dark-color-scheme ? #1E1E1EB3 : #FFFFFF;
    out property <brush> focus-stroke-inner: dark-color-scheme ? #000000B3 : #FFFFFF;
    out property <brush> focus-stroke-outer: dark-color-scheme ? #FFFFFF : (is-aero ? #00A8E8 : #000000E6);
    out property <brush> control-background-stroke-flyout: dark-color-scheme ? #00000033 : (is-aero ? #3D84AC : #0000000F);
    out property <brush> sub-title-secondary: dark-color-scheme ? #FFFFFF0F : (is-aero ? #D9EFFB : #0000000A);
    out property <brush> sub-title-tertiary: dark-color-scheme ? #FFFFFF0A : (is-aero ? #E7F5FD : #00000005);
    out property <brush> shadow: dark-color-scheme ? #00000042 : (is-aero ? #2C6E8C66 : #00000024);
    out property <brush> subtle: dark-color-scheme ? #FFFFFF0F : (is-aero ? #E3F3FC : #0000000A);
    out property <brush> subtle-secondary: dark-color-scheme ? #FFFFFF0F : (is-aero ? #D4EBF9 : #0000000A);
    out property <brush> subtle-tertiary: dark-color-scheme ? #FFFFFF0A : (is-aero ? #EDF8FD : #00000005);
    out property <brush> divider: dark-color-scheme ? #FFFFFF14 : (is-aero ? #C2E2F3 : #00000014);
    out property <brush> layer-on-mica-base-alt: dark-color-scheme ? #3A3A3A73 : (is-aero ? #EDF8FFB3 : #FFFFFFB3);
    out property <brush> layer-on-mica-base-alt-secondary: dark-color-scheme ? #FFFFFF0F : (is-aero ? #D6EDFB : #0000000A);
    out property <brush> card-stroke: dark-color-scheme ? #0000001A : (is-aero ? #79B9DA : #0000000F);
    out property <brush> state: dark-color-scheme ? #ffffff : (is-aero ? #001A2A : #000000);
    out property <brush> state-secondary: dark-color-scheme ? #000000 : (is-aero ? #FFFFFF : #ffffff);
}

export global Icons {
    out property <image> arrow-down: @image-url("_arrow-down.svg");
    out property <image> arrow-up: @image-url("_arrow-up.svg");
    out property <image> check-mark: @image-url("_check-mark.svg");
    out property <image> chevron-down: @image-url("_chevron-down.svg");
    out property <image> chevron-up: @image-url("_chevron-up.svg");
    out property <image> down: @image-url("_down.svg");
    out property <image> dropdown: @image-url("_dropdown.svg");
    out property <image> left: @image-url("_left.svg");
    out property <image> right: @image-url("_right.svg");
    out property <image> up: @image-url("_up.svg");
    out property <image> keyboard: @image-url("_keyboard.svg");
    out property <image> clock: @image-url("_clock.svg");
    out property <image> arrow-back: @image-url("_arrow_back.svg");
    out property <image> arrow-forward: @image-url("_arrow_forward.svg");
    out property <image> edit: @image-url("_edit.svg");
    out property <image> calendar: @image-url("_calendar.svg");
}

export global FluentSizeSettings {
    out property <length> item-height: 40px;
}
