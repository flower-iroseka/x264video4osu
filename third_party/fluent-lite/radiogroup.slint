import { FluentMetrics, FluentPalette } from "styling.slint";
import { RadioButtonImplBase, RadioGroupImplBase } from "../common/radiogroup-base.slint";
import { FocusBorder } from "components.slint";

export component RadioButtonImpl inherits RadioButtonImplBase {
    private property <color> text-color: FluentPalette.foreground;

    // 原样式 32px，与其它控件一起压到 28px。
    min-height: max(28px, layout.min-height);

    states [
        disabled when !root.enabled || !root.group-enabled: {
            outer.border-color: root.checked ? transparent : FluentPalette.control-strong-stroke-disabled;
            outer.background: FluentPalette.control-alt-disabled;
            inner.border-color: root.checked ? FluentPalette.accent-disabled : transparent;
            root.text-color: FluentPalette.text-disabled;
        }
        pressed when root.pressed: {
            outer.background: transparent;
            inner.border-color: root.checked ? FluentPalette.tertiary-accent-background : FluentPalette.control-alt-quaternary;
            outer.border-color: root.checked ? transparent : FluentPalette.control-strong-stroke-disabled;
            inner.border-width: root.checked ? 5px : 3px;
        }
        hover when root.has-hover: {
            outer.background: root.checked ? transparent : FluentPalette.control-alt-tertiary;
            inner.border-width: root.checked ? 3px : 0px;
        }
    ]

    animate text-color { duration: 200ms; }

    layout := HorizontalLayout {
        // 原样式是 padding: 4px。这圈内边距会让圆点比同一列上的输入框/下拉框
        // 右移 4px，还会把整行撑宽，所以去掉——圆点直接对齐控件列。
        spacing: 8px;

        // 布局只管 x，圆自己定位才吸附得了整数设备像素，所以套一层等大的透明占位。
        circle-slot := Rectangle {
            width: 13px;
            height: self.width;
            y: (parent.height - self.height) / 2;
            background: transparent;

            outer := Rectangle {
                // 和复选框同理：边长和位置对齐到整数设备像素，否则 1px 的圆环会被
                // 抗锯齿摊开、看着发虚（见 FluentMetrics）。
                width: round(13px / FluentMetrics.device-pixel) * FluentMetrics.device-pixel;
                height: self.width;
                x: FluentMetrics.snap(circle-slot.absolute-position.x) - circle-slot.absolute-position.x;
                // 再往下挪一个设备像素：汉字的墨迹本来就比行框中心低一点，
                // 只按行框中点摆的话圆看起来会偏上（实测差 1 个设备像素）。
                y: FluentMetrics.snap(circle-slot.absolute-position.y + (circle-slot.height - self.height) / 2)
                    + FluentMetrics.device-pixel - circle-slot.absolute-position.y;
                background: root.checked ? transparent : FluentPalette.control-alt-secondary;
                border-radius: self.width / 2;
                // 按设备像素算，否则 125% 下这条圆环会有 0.25 像素落到相邻像素上
                border-width: FluentMetrics.device-pixel;
                border-color: FluentPalette.control-strong-stroke;

                animate background, border-color { duration: 150ms; }

                inner := Rectangle {
                    width: parent.width;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: root.checked ? FluentPalette.state-secondary : transparent;
                    border-width: 4px;
                    border-color: root.checked ? FluentPalette.accent-background : transparent;

                    animate border-width { duration: 150ms; }
                }
            }
        }

        if root.text != "": Text {
            text: root.text;
            color: root.text-color;
            vertical-alignment: center;
            horizontal-alignment: left;
        }
    }

    if root.has-focus && root.enabled && root.group-enabled: FocusBorder {
        border-radius: 7px;
    }
}

export component RadioGroupImpl inherits RadioGroupImplBase {
    title-color: !root.enabled ? FluentPalette.text-disabled : FluentPalette.control-foreground;
    title-font-size: 1rem;
    title-font-weight: FontWeight.normal;
}

export component RadioGroup inherits RadioGroup { }
