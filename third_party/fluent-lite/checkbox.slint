import { FluentMetrics, FluentPalette, Icons } from "styling.slint";
import { FocusBorder } from "components.slint";

export component CheckBox {
    in property <string> text;
    in property <bool> enabled <=> touch-area.enabled;
    in property <length> font-size;
    in property <int> font-weight;
    in property <string> tooltip-text: "";
    out property <bool> has-focus: focus-scope.has-focus;
    in-out property <bool> checked;

    callback toggled;

    private property <color> text-color: FluentPalette.foreground;

    // 原样式 18px。跟 12px 的字号对齐，收到 13px。
    min-height: max(13px, layout.min-height);
    accessible-checkable: true;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-checked <=> root.checked;
    accessible-role: checkbox;
    accessible-action-default => {
        if (root.enabled) {
           root.checked = !root.checked;
           root.toggled();
        }
    }
    forward-focus: focus-scope;

    states [
        disabled when !root.enabled : {
            border.border-color: FluentPalette.control-strong-stroke-disabled;
            background.background: root.checked ? FluentPalette.accent-disabled : FluentPalette.control-alt-disabled;
            icon.colorize: FluentPalette.text-accent-foreground-disabled;
            root.text-color: FluentPalette.text-disabled;
        }
        pressed when touch-area.pressed : {
            border.border-color: FluentPalette.control-strong-stroke-disabled;
            background.background: root.checked ? FluentPalette.tertiary-accent-background : FluentPalette.control-alt-quaternary;
            icon.colorize: FluentPalette.text-accent-foreground-secondary;
        }
        hover when touch-area.has-hover : {
            background.background: root.checked ?  FluentPalette.secondary-accent-background : FluentPalette.control-alt-tertiary;
        }
        checked when root.checked && root.enabled : {
            background.background: FluentPalette.accent-background;
        }
    ]

    animate text-color { duration: 200ms; }

    layout := HorizontalLayout {
        // 原样式是 12px，和行内其它控件比显得方框离文字太远；收到 6px。
        spacing: 6px;

        // 布局只管 x，方框自己定位才吸附得了整数设备像素，所以套一层等大的透明占位。
        box-slot := Rectangle {
            width: 13px;
            height: self.width;
            y: (parent.height - self.height) / 2;
            background: transparent;

            background := Rectangle {
                // 原样式 18px。边长和位置都吸附到整数设备像素：布局算出来的坐标常带
                // 小数设备像素，1px 的边框横跨两个像素就会被抗锯齿摊成两条浅灰线，
                // 看着比系统控件糊。吸附之后边框才是一条实的细线。
                width: round(13px / FluentMetrics.device-pixel) * FluentMetrics.device-pixel;
                height: self.width;
                x: FluentMetrics.snap(box-slot.absolute-position.x) - box-slot.absolute-position.x;
                // 再往下挪一个设备像素：汉字的墨迹本来就比行框中心低一点，
                // 只按行框中点摆的话方框看起来会偏上（实测差 1 个设备像素）。
                y: FluentMetrics.snap(box-slot.absolute-position.y + (box-slot.height - self.height) / 2)
                    + FluentMetrics.device-pixel - box-slot.absolute-position.y;
                background: FluentPalette.control-alt-secondary;
                border-radius: 2px;

                animate background, border-color { duration: 150ms; }

                border := Rectangle {
                    border-color: FluentPalette.control-strong-stroke;
                    // 按设备像素算，1 逻辑像素在 125% 下是 1.25 设备像素，会多出半格灰边
                    border-width: root.checked ? 0 : FluentMetrics.device-pixel;
                    border-radius: parent.border-radius;
                }

                icon := Image {
                    image-fit: contain;
                    visible: root.checked;
                    source: Icons.check-mark;
                    colorize: FluentPalette.accent-foreground;
                    width: 8px;
                    accessible-role: none;

                    animate colorize { duration: 150ms; }
                }
            }
        }

        if root.text != "" : Text {
            text: root.text;
            color: root.text-color;
            font-size: root.font-size;
            font-weight: root.font-weight;
            vertical-alignment: center;
            horizontal-alignment: left;
        }
    }

    touch-area := TouchArea {
        clicked => {
            // 点击时把焦点让给不可见目标，使正在编辑的文本框失焦
            focus-blank.focus();
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled();
            }
        }
    }

    // 不可见焦点清除目标：宽度 0、不参与点击与 Tab 遍历，仅作 `focus()` 接收端
    focus-blank := FocusScope {
        x: 0;
        width: 0;
        height: 0;
        focus-on-click: false;
        focus-on-tab-navigation: false;
    }

    focus-scope := FocusScope {
        x: 0;
        width: 0; // Do not react on clicks
        enabled <=> root.enabled;

        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                touch-area.clicked();
                return accept;
            }
            return reject;
        }
    }

    // focus border
    if root.has-focus && root.enabled : FocusBorder {
        border-radius: 4px;
    }

    // Tooltip 必须排在 touch-area 之后（更上层），TooltipArea 才能收到鼠标事件
    if (root.tooltip-text != ""): Tooltip {
        Rectangle {
            background: FluentPalette.alternate-background;
            border-radius: 4px;
            border-width: 1px;
            border-color: FluentPalette.border;
            VerticalLayout {
                padding-left: 9px;
                padding-right: 9px;
                padding-top: 6px;
                padding-bottom: 6px;
                Text {
                    text: root.tooltip-text;
                    font-size: 12px;
                    color: FluentPalette.foreground;
                }
            }
        }
    }
}
