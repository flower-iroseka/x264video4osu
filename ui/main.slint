// 日志面板。滚动由 Rust 端驱动：启用自动滚动时在追加日志后把
// viewport-y 设为内容底部；关闭后不干预，用户可自由滚动。
// 用 ListView 逐行渲染，而不是「ScrollView + 单个 Text」：Slint 1.17 里
// ScrollView 内元素的宽度一旦绑定到视口宽度就形成绑定环，内容被钳制到
// 可视区、永远不溢出 → 没有滚动条，滚动与自动滚动全部失效。
// ListView 每行独立布局（占满全宽、自动换行），视口高度随行数正确增长。
component LogView inherits VerticalLayout {
    in property <[string]> log-lines;
    in property <bool> auto-scroll: true;

    in-out property <length> viewport-y <=> i-scroll-view.viewport-y;
    out property <length> viewport-height <=> i-scroll-view.viewport-height;
    out property <length> visible-height <=> i-scroll-view.visible-height;

    // 由 Rust 端在追加日志且启用自动滚动时调用（滚动到底部）
    callback scroll-to-end();

    i-scroll-view := ListView {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        for line in root.log-lines: Text {
            text: line;
            wrap: word-wrap;
            font-family: "Consolas";
            font-size: 11px;
        }
    }

    scroll-to-end => {
        // Flickable 的 viewport-y 向下为负（运行时取 -viewport-y 作为滚动偏移），
        // 所以到底部要写负值；写成正值会被钳制回顶部，导致“自动滚动”无效。
        i-scroll-view.viewport-y = -(i-scroll-view.viewport-height - i-scroll-view.visible-height);
    }
}

// 细线：分组分隔线和进度条描边共用同一条。页面底色是 #f0f0f0，
// 这个色只深 8 个色阶，是那种不凑近看几乎注意不到的灰。
global ThinLine {
    out property <color> color: #E8E8E8;
    out property <length> width: 1px;
}

// 分组分隔线，用来把主页的选项分成「文件 / 编码 / 音频 / 裁剪 / 其它」几组。
// 自身 10.6px 高、线画在中间，配合外层 2.4px 的行距，每组之间上下各留 7.2px
// （就是原来各 4px + 2px 的 1.2 倍）。
component GroupSeparator inherits Rectangle {
    height: 10.6px;
    background: transparent;

    Rectangle {
        y: 4.8px;
        width: parent.width;
        height: ThinLine.width;
        background: ThinLine.color;
    }
}

// 自定义进度条：轨道与填充同高（12px，对齐 WPF <ProgressBar Height="12">）。
// std-widgets 的 ProgressIndicator 内部轨道硬编码 1px，加粗后轨道与填充高度不匹配，
// 故自定义为全高轨道框 + 同高填充，颜色沿用 FluentPalette 保持一致。
component ThickProgressBar {
    in property <float> progress;

    height: 12px;
    horizontal-stretch: 1;

    Rectangle {
        // 轨道（背景框）：纯白底，外圈一条 1px 细描边，用分组分隔线同款的
        // ThinLine。#F0F0F0 那种颜色跟页面底色一样，等于没有边。
        background: #FFFFFF;
        border-radius: 3px;
        border-width: ThinLine.width;
        border-color: ThinLine.color;
        clip: true;

        // 填充：宽度随进度变化，向内缩 1px 避开黑色边框（高度同减），
        // 颜色用 Windows/VS Code 默认蓝 #0078D4。
        Rectangle {
            x: 1px;
            y: 1px;
            width: (parent.width - 2px) * min(1.0, max(0.0, root.progress));
            height: parent.height - 2px;
            background: #0078D4;
        }
    }
}

// 带圈 i 提示按钮：悬停时圈和文字轻微亮起；点击才弹出 osu! 格式建议气泡。
// 对应旧程序 MainWindow.xaml 中 FormatBox 右侧的提示句柄
// （Grid + Ellipse + "i"，ToolTipService.InitialShowDelay=0）。
// 气泡位置按点击点计算并右下方偏移 16px，避开鼠标指针；
// 任意位置点击（close-on-click）或 15 秒后自动隐藏。
component FormatTip inherits Rectangle {
    in property <string> tip-text;

    width: 16px;
    height: 16px;

    // 圈 + i 图标（悬停或气泡打开时轻微亮起：填充变亮、边框与文字泛蓝）
    Rectangle {
        border-radius: 8px;
        border-width: 1.2px;
        border-color: touch.has-hover || tip.is-open ? #0078D4 : #7F7F7F;
        background: touch.has-hover || tip.is-open ? #E3F2FD : #CFCFCF;
        Text {
            text: "i";
            font-weight: 700;
            font-size: 11px;
            color: touch.has-hover || tip.is-open ? #0078D4 : #5A5A5A;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 记录点击时的鼠标位置作为气泡锚点。不能直接绑定 touch.mouse-x，
    // 否则气泡会跟着鼠标移动，无法“避开鼠标”。
    property <length> popup-x: 0px;
    property <length> popup-y: 0px;

    // 不可见焦点清除目标：宽度 0、不参与点击与 Tab 遍历，仅作 `focus()` 接收端，
    // 让正在编辑的文本框在点击此控件时失焦（与其它可点击控件保持一致）。
    focus-blank := FocusScope {
        x: 0;
        width: 0;
        height: 0;
        focus-on-click: false;
        focus-on-tab-navigation: false;
    }

    // 按钮交互：悬停仅驱动亮起（has-hover）；点击切换气泡显示
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus-blank.focus();
            if tip.is-open {
                tip.close();
            } else {
                popup-x = self.pressed-x + 16px;
                popup-y = self.pressed-y + 16px;
                tip.show();
                close-timer.running = false;
                close-timer.running = true;
            }
        }
    }

    // 提示气泡：锚定在点击位置右下方，避开鼠标
    tip := PopupWindow {
        close-policy: close-on-click;
        x: popup-x;
        y: popup-y;
        width: tip-content.preferred-width;
        height: tip-content.preferred-height;
        tip-content := Rectangle {
            background: #FFFFFF;
            border-width: 1px;
            border-color: #C0C0C0;
            border-radius: 4px;
            VerticalBox {
                padding: 8px;
                Text {
                    text: root.tip-text;
                    wrap: word-wrap;
                    width: 260px;
                    font-size: 11px;
                    color: #333333;
                }
            }
        }
    }

    // 15 秒自动隐藏（一次性定时器）
    close-timer := Timer {
        interval: 15000ms;
        running: false;
        triggered => {
            self.running = false;
            tip.close();
        }
    }
}

// 带悬停工具提示的字段标签。提示触发区 = 标签文字本身；Tooltip 必须排在
// 组件的其它指针目标之后（这里就是最后一个子元素），TooltipArea 才能收到鼠标事件。
component TippableLabel inherits Text {
    in property <string> tip: "";

    if (root.tip != ""): Tooltip {
        Rectangle {
            background: Palette.alternate-background;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                padding-left: 9px;
                padding-right: 9px;
                padding-top: 6px;
                padding-bottom: 6px;
                Text { text: root.tip; font-size: 12px; color: Palette.foreground; }
            }
        }
    }
}

// 编码方法单选行。RadioButton 是编译器内建伪元素，类型检查不允许自定义属性
// （tooltip-text 会在 lowering 前报 Unknown property），单选项 tooltip 不可行；
// 故把整行（RadioGroup）作为提示触发区：Tooltip 排在 RadioGroup 之后即最上层，
// 悬停任一选项都能看到同一说明，点击仍正常透传。
component MethodRadioRow {
    in property <string> tip;
    callback selected(string);

    // 隐式根是裸 Rectangle：preferred=0 / stretch=1，放在布局里会被撑满整行，
    // RadioGroup 内部的 GridLayout 把两个单选按钮居中到窗口中间。显式把根尺寸
    // 绑到 RadioGroup 的内容尺寸（min-width/min-height），保持紧凑靠左。
    width: rg.min-width;
    height: rg.min-height;

    rg := RadioGroup {
        orientation: horizontal;
        selected(text) => { root.selected(text); }
        RadioButton { text: "CRF"; checked: true; }
        RadioButton { text: "2pass"; }
    }

    if (root.tip != ""): Tooltip {
        Rectangle {
            background: Palette.alternate-background;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                padding-left: 9px;
                padding-right: 9px;
                padding-top: 6px;
                padding-bottom: 6px;
                Text { text: root.tip; font-size: 12px; color: Palette.foreground; }
            }
        }
    }
}

// 裁剪单位单选行。写法和限制与 MethodRadioRow 相同（RadioButton 是编译器内建
// 伪元素，不支持自定义属性，所以 tooltip 挂在整行上）。
// RadioButton 的 text 既是显示文本也是 selected() 回传值，没有独立的值字段，
// 因此这里传本地化文本，Rust 侧拿当前语言的字符串比对来判断选的是哪一项。
component TrimUnitRow {
    in property <string> tip;
    in property <string> frames-text;
    in property <string> time-text;
    // 组件不是内建控件，enabled 不是内建属性，要自己声明再转给 RadioGroup
    in property <bool> enabled: true;
    callback selected(string);

    width: rg.min-width;
    height: rg.min-height;

    rg := RadioGroup {
        enabled: root.enabled;
        orientation: horizontal;
        selected(text) => { root.selected(text); }
        RadioButton { text: root.frames-text; checked: true; }
        RadioButton { text: root.time-text; }
    }

    if (root.tip != ""): Tooltip {
        Rectangle {
            background: Palette.alternate-background;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                padding-left: 9px;
                padding-right: 9px;
                padding-top: 6px;
                padding-bottom: 6px;
                Text { text: root.tip; font-size: 12px; color: Palette.foreground; }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "x264video4osu";
    // 使用系统原生标题栏。尺寸按语言分两套：中文标签短，窗口更窄；英文标签长，留宽一点。
    // label-col-w 是左侧标签列宽度，实测中文最长标签 48px、英文 70px，各留几像素余量。
    // app.rs 的 DPI 修正直接读这两个属性，不重复写死。
    out property <length> label-col-w: root.language-index == 0 ? 52px : 78px;
    // 主体（收起预览时）的宽度。展开预览后窗口 = 主体 + 预览列。
    out property <length> main-w: root.language-index == 0 ? 440px : 520px;
    out property <length> window-w: root.main-w + (root.preview-expanded ? root.preview-w : 0px);
    // 「音频模式」下拉框要放下最长的选项（英文 "Copy audio stream" 实测 101px，
    // 加上下拉框自身左右各 11px 内边距和 20px 箭头 ≈ 143px），中文短一些。
    out property <length> audio-combo-w: root.language-index == 0 ? 112px : 150px;
    width: root.window-w;
    height: root.window-h;
    // 高度按内容实测：Video 页内容加底部按钮栏最少约 475px，留一点余量。
    // 再多出来的高度会进页面里的弹性占位，所以不用卡得很死。
    // 竖直间距改成 1.2 倍后总共长了约 18px，跟着加，不然最后一行会被裁掉。
    // 后来结果行改成常驻（见下面的结果面板），又占掉约 7px，同样加上。
    out property <length> window-h: 544px;

    // ---- 视频预览面板 ----
    // 收起时预览列宽度为 0，窗口就是原来的主体宽度；展开后窗口向右长出一列。
    // 宽度按第一行的控制走：左右两段各 214px（时间 / 帧数）夹住中间 156px 的
    // 播放键组，再加上音量条和静音键，540px 装不下；英文标签更长，所以留到 620。
    out property <length> preview-w: 620px;
    // 画面区以外的固定高度。整块内容要上下居中，得先知道控件区有多高，
    // 所以下面几项都按控件的实际高度写死：进度条 20px（fluent Slider 的 min-height）、
    // 两行控件各 28px（图标按钮 / 输入框的高度），再加画面到进度条、进度条到
    // 第一行、第一行到第二行这三处行距。改这几行的高度时这里要跟着改。
    out property <length> video-pad: 10px;
    out property <length> slider-h: 20px;
    out property <length> control-row-h: 28px;
    // 第一行左右两段固定成一样宽，中间那组播放键才是真正居中的
    // （两边宽度不同的话，中间会被挤偏）。算法是
    // (preview-w - video-pad*2 - 两处 8px 行距 - 播放键组 156px) / 2，
    // 改面板宽度或播放键个数时要跟着改，不然播放/暂停键就不在正中间了。
    out property <length> preview-side-w: 214px;
    // 音量条的长度。写死而不是让它伸缩：右边帧数的位数会变（9 位变 10 位），
    // 伸缩的话音量条会跟着一抽一抽的。
    out property <length> volume-slider-w: 88px;
    out property <length> preview-gap: 6px;
    out property <length> preview-controls-h: root.slider-h + root.control-row-h * 2
        + root.preview-gap * 3;
    // 画面外圈那层边框：1px 空隙 + 1px 边线。留这 1px 空隙是为了不管画面什么
    // 比例，边线和画帧之间都隔着一条底色。
    out property <length> video-frame: 2px;
    // 画面宽高比，由 app.rs 探测到后写进来；没有视频时按 16:9
    in property <float> video-aspect: 1.7777778;
    // 画面按比例塞进「面板宽 × (面板高 - 控件区)」这个框：宽度先受限就吃满宽，
    // 高度先受限就吃满高。竖屏视频靠这一条才会缩窄，不会被拉变形。
    out property <length> video-max-w: root.preview-w - root.video-pad * 2
        - root.video-frame * 2;
    out property <length> video-max-h: max(0px, root.window-h - root.video-pad * 2
        - root.preview-controls-h - root.video-frame * 2);
    out property <length> video-w: min(root.video-max-w, root.video-max-h * root.video-aspect);
    out property <length> video-h: root.video-w / root.video-aspect;
    // 画面加控件整块在面板里上下居中。preview-top 同时当布局的 padding-top 和
    // 外圈边框的 y，两边共用一个值，不会对不上。
    // 上下内边距都用这个值，画面加控件才会真的落在中间：只给上边距的话，多出来的
    // 一截会留在布局里，被 VerticalBox 摊给两行控件，宽屏视频下按钮会被撑成大块。
    out property <length> preview-top: max(root.video-pad,
        (root.window-h - (root.video-h + root.video-frame * 2 + root.preview-controls-h)) / 2);
    // 画面在面板里水平居中。这个算式和外层 VerticalBox 左右各留 video-pad、
    // 固定宽度的子元素被居中之后的结果是同一个值。
    out property <length> video-x: root.main-w + (root.preview-w - root.video-w) / 2;
    out property <length> video-y: root.preview-top + root.video-frame;
    // 展开状态。app.rs 启动时一律置为收起，不记上次的状态。
    in-out property <bool> preview-expanded: false;
    // 预览不可用（找不到 tools/ffmpeg.exe）时整个展开按钮和预览列都不出现。
    in property <bool> preview-available: true;

    background: Palette.background;

    in property <UiStrings> strings;


    // ---------- 输入数据 ----------
    in-out property <string> input-path: "";
    in-out property <string> output-path: "";
    in-out property <int> format-index: 0;
    in property <int> mode-index: 0;          // 0 = CRF, 1 = 2pass（Rust 端跟踪）
    in-out property <string> value-text: "26";
    in-out property <string> width-text: "0";
    in-out property <string> height-text: "720";
    in-out property <bool> scale-up: false;
    // ---------- 音频 / 裁剪 ----------
    in-out property <int> audio-mode-index: 0;      // 0 = 无音频, 1 = 复制音频流, 2 = 转码音频
    in-out property <int> audio-codec-index: 0;     // 0 = AAC, 1 = FLAC（仅 mp4）
    // FLAC 只在 mp4 下可选：非 mp4 时下拉框只有 AAC 一项
    in property <[string]> codec-model: root.format-index == 2 ? ["AAC", "FLAC"] : ["AAC"];
    in-out property <bool> trim-enabled: false;
    in-out property <string> trim-start-text: "";
    in-out property <string> trim-end-text: "";
    in property <bool> encoding: false;
    in property <bool> controls-enabled: true;
    in-out property <int> language-index: 0;

    // ---------- 进度 / 结果 ----------
    in property <bool> progress-visible: false;
    in property <bool> result-visible: false;
    in property <float> progress-value: 0.0;   // 0..1
    in property <string> pass-text: "";
    in property <string> percent-text: "";
    in property <string> eta-text: "";
    in property <string> elapsed-text: "";
    in property <string> output-size-text: "";

    // 进度数据文字颜色：非运行灰色，编码时黑色
    property <color> progress-text-color: root.encoding ? #000000 : #909090;

    // ---------- 日志 ----------
    in property <[string]> log-lines: [];
    in-out property <bool> auto-scroll: true;

    // ---------- 回调 ----------
    callback browse-input();
    callback browse-output();
    callback start-encode();
    callback stop-encode();
    // 提取音轨是独立的一次运行（只导音频、不编视频），所以是按钮不是复选框
    callback extract-audio();
    callback open-folder();
    callback save-log();
    callback show-about();
    callback language-changed(int);
    callback format-changed(int);
    callback mode-changed(string);
    callback trim-unit-changed(string);
    callback scroll-log-to-end();

    // ---------- 预览面板 ----------
    // 状态由 app.rs 每 30ms 从预览后端读一次后写进来。
    in-out property <bool> preview-loaded: false;
    // 当前要显示的画帧。后端出新帧时 app.rs 才写它，没新帧就不写。
    in property <image> preview-frame;
    in-out property <bool> preview-paused: true;
    // 当前位置 / 总时长，两个拼起来显示成「当前时间 / 视频总时间」
    in property <string> preview-time-text: "00:00:00.000";
    in property <string> preview-duration-text: "00:00:00.000";
    // 当前帧 / 总帧数。帧率探不出来时两个都是 "--"，帧数输入框同时禁用。
    in property <string> preview-frame-cur: "--";
    in property <string> preview-frame-total: "--";
    in property <bool> preview-fps-known: false;
    // 两个输入框：帧号和时间戳。改任意一个，app.rs 立刻把另一个换算成对应值写回来。
    in-out property <string> preview-frame-input: "0";
    in-out property <string> preview-time-input: "00:00:00.000";
    // 进度条位置，量程 0..1000（滑块本身就是这个量程）。app.rs 按当前显示帧的位置写它，
    // 但拖动期间（preview-scrubbing 为真）不写，免得把用户刚拖到的位置又拽回去。
    in-out property <float> preview-seek-1000: 0.0;
    in-out property <bool> preview-scrubbing: false;
    // 音量条位置 0..100，和后端的音量一一对应（后端的 VOLUME_MAX 也是 100）。
    // 拖动期间（preview-vol-dragging 为真）app.rs 不写它，理由和进度条一样。
    in-out property <float> preview-volume: 100.0;
    in-out property <bool> preview-vol-dragging: false;
    in-out property <bool> preview-muted: false;
    // 预览控件能不能用：文件加载好了、而且没在编码
    property <bool> preview-controls-on: root.preview-loaded && !root.encoding;
    // 预览的键盘快捷键生不生效。面板收起来时不留活口，免得在设置页敲空格
    // 把看不见的预览给放起来。
    property <bool> preview-keys-on: root.preview-controls-on && root.preview-expanded;

    callback preview-toggle-play();
    callback preview-step(int);          // +1 / -1 帧
    callback preview-seek(float);        // 0..1，松手时才发
    callback preview-seek-by(float);     // 相对当前位置跳，单位秒，可负（快捷键用）
    callback preview-set-volume(float);  // 0..100，拖动过程中一直发
    callback preview-volume-step(float); // 在当前音量上加减，↑/↓ 用
    callback preview-toggle-mute();
    callback preview-goto-start();       // 跳到视频开头
    callback preview-goto-end();         // 跳到视频结尾
    // 预览出了新帧，让界面立刻同步一次。由预览线程发起，比 30ms 的轮询快得多。
    callback preview-sync();
    callback preview-frame-edited(string);   // 用户改了帧号框
    callback preview-time-edited(string);    // 用户改了时间戳框
    callback preview-jump-to-input();        // 跳到输入框指定的位置
    callback preview-set-trim-start();
    callback preview-set-trim-end();
    callback preview-toggle-expanded();

    // 转发给日志组件，供 Rust 端在自动滚动时调用
    scroll-log-to-end => { log-view.scroll-to-end(); }

    // 把键盘焦点收回预览快捷键那一层。app.rs 在启动和展开面板时调；预览里会抢焦点
    // 的那几个控件（第二行的三个按钮、进度条）点完也会调回来。
    //
    // 为什么非得显式收：Slint 只把按键送给「当前有焦点的那个元素」，没有元素有焦点
    // 时按键直接丢掉。另外 bg-focus 和预览列是兄弟节点，不是它的祖先，所以焦点跑到
    // 预览控件上之后键也不会冒泡过来——只能主动把它拉回焦点。
    //
    // fluent-lite 的 Button 点击时会 focus() 到一个不可见的空 FocusScope（为了让
    // 正在编辑的文本框失焦），进度条的 SliderBase 按下时也会 focus() 自己，这两处
    // 都会把焦点从 bg-focus 带走，不收回来快捷键就一直收不到键。
    public function focus-preview-keys() {
        bg-focus.focus();
    }

    // 根容器：普通 Rectangle（非布局），子元素用绝对坐标摆放。
    // 窗口用系统原生标题栏，主体 VerticalBox 铺满整个窗口。
    base := Rectangle {
        width: parent.width;
        height: parent.height;

        // ---- 全局背景 FocusScope ----
        // Slint 默认点击空白区域不会清除焦点（只有点其它文本框才会切换焦点）。
        // 在窗口最底层放一个铺满窗口的 FocusScope，点击非交互区域（空白、标签、
        // 面板背景等）时它自动夺取焦点，让正在编辑的文本框失焦。
        // 必须是最底层（第一个子元素）：其它控件先拿到点击时它不参与，不干扰交互。
        // focus-on-tab-navigation 关掉，避免在 Tab 焦点链里多出一个不可见停靠点。
        bg-focus := FocusScope {
            width: parent.width;
            height: parent.height;
            focus-on-tab-navigation: false;

            // ---- 预览的键盘快捷键 ----
            // 键位照 PotPlayer 1.7 的默认键位表挑的。
            //
            // 用 key-pressed 不用 capture_key_pressed：capture_* 在焦点元素之前跑，
            // 会在用户往帧号框里打字时也把空格吃掉；key-pressed 是焦点元素拒绝之后
            // 才轮到的，文本输入天然优先。
            //
            // 字母和方括号按「字符」匹配（Slint 的 Key.D 就是 "d"），大小写各写一次，
            // 免得 CapsLock 或者按着 Shift 时失灵。
            key-pressed(event) => {
                if (!root.preview-keys-on) {
                    reject
                } else if (event.text == Key.Space) {
                    root.preview-toggle-play();
                    accept
                } else if (event.text == Key.LeftArrow) {
                    // Ctrl 30 秒 / Shift 1 分钟 / 不带修饰 5 秒
                    if (event.modifiers.control) {
                        root.preview-seek-by(-30);
                    } else if (event.modifiers.shift) {
                        root.preview-seek-by(-60);
                    } else {
                        root.preview-seek-by(-5);
                    }
                    accept
                } else if (event.text == Key.RightArrow) {
                    if (event.modifiers.control) {
                        root.preview-seek-by(30);
                    } else if (event.modifiers.shift) {
                        root.preview-seek-by(60);
                    } else {
                        root.preview-seek-by(5);
                    }
                    accept
                } else if (event.text == Key.UpArrow) {
                    // 交给 Rust 侧按实时音量加，别拿界面那份轮询快照加：
                    // 连按两下会都按同一个旧值算，只涨一档
                    root.preview-volume-step(5);
                    accept
                } else if (event.text == Key.DownArrow) {
                    root.preview-volume-step(-5);
                    accept
                } else if (event.text == Key.M || event.text == "M") {
                    root.preview-toggle-mute();
                    accept
                } else if (event.text == Key.D || event.text == "D") {
                    root.preview-step(-1);
                    accept
                } else if (event.text == Key.F || event.text == "F") {
                    root.preview-step(1);
                    accept
                } else if (event.text == Key.Home) {
                    root.preview-goto-start();
                    accept
                } else if (event.text == Key.End) {
                    root.preview-goto-end();
                    accept
                } else if (event.text == Key.OpenBracket) {
                    root.preview-set-trim-start();
                    accept
                } else if (event.text == Key.CloseBracket) {
                    root.preview-set-trim-end();
                    accept
                } else {
                    reject
                }
            }
        }

        // ---- 主体内容 ----
        // 宽度只占 main-w：预览列是它的兄弟节点，占右边那一列。
        // x 必须显式写 0：只给 width 不给 x 的话，Slint 会把它水平居中，
        // 展开窗口时看着就像整个界面被推到了中间。
        main-col := VerticalBox {
            x: 0px;
            y: 0px;
            width: root.main-w;
            height: parent.height;
            // 竖直方向的间距统一放大到 1.2 倍（原来 padding 6px / spacing 3px），
            // 左右不动，只调上下。
            padding-left: 6px;
            padding-right: 6px;
            padding-top: 7.2px;
            // 底部比顶部留得多一点：最下面是一排带边框的按钮，挨着窗口边缘太挤
            padding-bottom: 12px;
            // 和 padding-bottom 取同一个值：底部按钮到窗口底边、到设置面板下边框的
            // 距离要一样，不然按钮看着是贴在面板上的
            spacing: 12px;

        main-tabs := TabWidget {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            Tab { title: strings.tab-video;
                Rectangle {
                    background: Palette.alternate-background;
                    border-width: 1px;
                    // 页面内边框用 WPF 原版的极浅 1px 细线 #E0E0E0（而非 palette 的深灰）
                    border-color: #E0E0E0;
                    border-radius: 4px;
                    VerticalBox {
                        // 左右各 10px：原来和后边距一样的 6px 让文字几乎贴着页面内边框。
                        // 上下按 1.2 倍放大（原来各 6px），行距同样 1.2 倍（原来 2px）。
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 7.2px;
                        padding-bottom: 7.2px;
                        spacing: 2.4px;

                        // ---- 输入文件 ----
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            TippableLabel { text: strings.label-input; tip: strings.tip-input-path; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            LineEdit { horizontal-stretch: 1; min-width: 240px; text <=> root.input-path; tooltip-text: strings.tip-input-path; }
                            Button { text: strings.button-browse; min-width: 50px; tooltip-text: strings.tip-browse-input; clicked => { root.browse-input(); } }
                        }

                        // ---- 输出文件 ----
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            TippableLabel { text: strings.label-output; tip: strings.tip-output-path; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            LineEdit { horizontal-stretch: 1; min-width: 240px; text <=> root.output-path; tooltip-text: strings.tip-output-path; }
                            Button { text: strings.button-browse; min-width: 50px; tooltip-text: strings.tip-browse-output; clicked => { root.browse-output(); } }
                        }

                        GroupSeparator { }

                        // ---- 输出格式 ----
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            TippableLabel { text: strings.label-format; tip: strings.tip-format; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            ComboBox { width: 80px; model: ["flv", "avi", "mp4"]; tooltip-text: strings.tip-format; current-index <=> root.format-index; selected => { root.format-changed(root.format-index); } }
                            FormatTip { tip-text: strings.format-tip; }
                            // 每行末尾都要有一个弹性占位吸收剩余宽度。标签用的是 min-width
                            // （不是固定 width），行里没人吸收余量时 Slint 会把余量摊给所有
                            // 子元素，标签列就会被撑宽、跟别的行对不齐。
                            Rectangle { horizontal-stretch: 1; }
                            // 「提取音轨」搭在这行右端。它跟输出格式没关系，靠整段空白隔开、
                            // 贴住行尾，看着才不会跟格式下拉框混成一组。
                            Button {
                                text: strings.button-extract-audio;
                                tooltip-text: strings.tip-extract-audio;
                                enabled: !root.encoding;
                                clicked => { root.extract-audio(); }
                            }
                        }

                        // ---- 编码方式 ----
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            TippableLabel { text: strings.label-method; tip: strings.tip-method; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            MethodRadioRow { tip: strings.tip-method; selected(text) => { root.mode-changed(text); } }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        // ---- 数值框（2pass 码率 / CRF 质量） ----
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { min-width: root.label-col-w; horizontal-stretch: 0; }
                            LineEdit { width: 80px; text <=> root.value-text; tooltip-text: strings.tip-value; }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        // ---- 分辨率 ----
                        // LineEdit 默认 horizontal-stretch:1 / min-width:160px，放进行内会拉满整行、
                        // 把 caption 撑开。这里固定输入框宽度（70px，可容纳 5 位数）并禁止拉伸。
                        // 「宽度」标签与上面输入框的起始列对齐（紧跟 90px 标签列），输入框紧贴其后；
                        // 剩余横向空间按 45%:55% 分割，在约 45% 处放入「高度」+ 高度输入框。
                        HorizontalLayout {
                            vertical-stretch: 0;
                            // 与上面各行的 spacing:4px 一致，保证「宽度」跟输入框的起始列对齐
                            spacing: 4px;
                            TippableLabel { text: strings.label-resolution; tip: strings.tip-resolution; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            HorizontalLayout {
                                spacing: 3px;
                                TippableLabel { text: strings.label-width; tip: strings.tip-width; vertical-alignment: center; }
                                LineEdit { min-width: 70px; horizontal-stretch: 0; text <=> root.width-text; tooltip-text: strings.tip-width; }
                            }
                            Rectangle { horizontal-stretch: 45; }
                            HorizontalLayout {
                                spacing: 3px;
                                TippableLabel { text: strings.label-height; tip: strings.tip-height; vertical-alignment: center; }
                                LineEdit { min-width: 70px; horizontal-stretch: 0; text <=> root.height-text; tooltip-text: strings.tip-height; }
                            }
                            Rectangle { horizontal-stretch: 55; }
                        }

                        GroupSeparator { }

                        // ---- 音频模式 ----
                        // 「转码音频」时才在同行右侧露出「音频编码」下拉框；FLAC 只在 mp4 下可选。
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            TippableLabel { text: strings.label-audio-mode; tip: strings.tip-audio-mode; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            ComboBox {
                                width: root.audio-combo-w;
                                model: [strings.audio-none, strings.audio-copy, strings.audio-transcode];
                                tooltip-text: strings.tip-audio-mode;
                                current-index <=> root.audio-mode-index;
                            }
                            if (root.audio-mode-index == 2): TippableLabel { text: strings.label-audio-codec; tip: strings.tip-audio-codec; vertical-alignment: center; }
                            if (root.audio-mode-index == 2): ComboBox {
                                width: 80px;
                                model: root.codec-model;
                                tooltip-text: strings.tip-audio-codec;
                                current-index <=> root.audio-codec-index;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        GroupSeparator { }

                        // ---- 视频裁剪 ----
                        // 复选框和标签列左对齐，不再像原来那样再缩进 10px
                        // 未勾选时下面两行整体置灰（enabled 会向子元素传递），也不参与编码。
                        HorizontalLayout {
                            CheckBox { vertical-stretch: 0; text: strings.check-trim; tooltip-text: strings.tip-trim; checked <=> root.trim-enabled; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            TippableLabel { text: strings.label-trim-unit; tip: strings.tip-trim-unit; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            TrimUnitRow {
                                tip: strings.tip-trim-unit;
                                frames-text: strings.trim-frames;
                                time-text: strings.trim-time;
                                enabled: root.trim-enabled;
                                selected(text) => { root.trim-unit-changed(text); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            TippableLabel { text: strings.label-trim-range; tip: strings.tip-trim; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            TippableLabel { text: strings.label-trim-start; tip: strings.tip-trim-start; vertical-alignment: center; }
                            LineEdit { min-width: 110px; horizontal-stretch: 0; enabled: root.trim-enabled; text <=> root.trim-start-text; tooltip-text: strings.tip-trim-start; }
                            Rectangle { horizontal-stretch: 1; }
                            TippableLabel { text: strings.label-trim-end; tip: strings.tip-trim-end; vertical-alignment: center; }
                            LineEdit { min-width: 110px; horizontal-stretch: 0; enabled: root.trim-enabled; text <=> root.trim-end-text; tooltip-text: strings.tip-trim-end; }
                        }

                        GroupSeparator { }

                        // ---- 复选项（和上面的标签列左对齐，不再额外缩进） ----
                        HorizontalLayout {
                            CheckBox { vertical-stretch: 0; text: strings.check-scale-up; tooltip-text: strings.tip-scale-up; checked <=> root.scale-up; }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        // ---- 弹性占位：吸收富余高度，让设置行保持紧凑不拉伸 ----
                        Rectangle { vertical-stretch: 1; }

                        // ---- 结果面板（编码结束后显示） ----
                        // 这一行常驻，只切换内容显不显示。原来是用 if 整行插入/移除，
                        // 编码一结束标签页的最小高度就变大，把底部的开始/停止那一排顶下去，
                        // 窗口高度是写死的，看着就是按钮上下跳了一下。
                        HorizontalLayout {
                            min-height: 28px;
                            spacing: 8px;
                            Text {
                                visible: root.result-visible;
                                text: root.output-size-text;
                                vertical-alignment: center;
                            }
                            Button {
                                visible: root.result-visible;
                                text: strings.button-open-folder;
                                tooltip-text: strings.tip-open-folder;
                                clicked => { root.open-folder(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        // ---- 进度面板：常驻显示，固定在标签页最底部 ----
                        VerticalLayout {
                            spacing: 4px;
                            // 高度 12px，对齐旧程序 MainWindow.xaml 中 <ProgressBar Height="12">
                            ThickProgressBar { progress: root.progress-value; }
                            HorizontalLayout {
                                spacing: 6px;
                                Text { text: root.pass-text; width: 60px; vertical-alignment: center; color: root.progress-text-color; }
                                Text { text: root.percent-text; width: 60px; vertical-alignment: center; color: root.progress-text-color; }
                                Text { text: root.eta-text; width: 80px; vertical-alignment: center; color: root.progress-text-color; }
                                Text { text: root.elapsed-text; horizontal-stretch: 1; vertical-alignment: center; color: root.progress-text-color; }
                            }
                        }
                    }
                }
            }

            Tab { title: strings.tab-log;
                Rectangle {
                    background: Palette.alternate-background;
                    border-width: 1px;
                    // 页面内边框用 WPF 原版的极浅 1px 细线 #E0E0E0
                    border-color: #E0E0E0;
                    border-radius: 4px;
                    VerticalBox {
                        // 同样按 1.2 倍放大竖直方向的间距（原来上下各 8px、行距 6px）
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 9.6px;
                        padding-bottom: 9.6px;
                        spacing: 7.2px;
                        log-view := LogView {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            log-lines: root.log-lines;
                            auto-scroll: root.auto-scroll;
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 10px;
                            CheckBox { text: strings.check-auto-scroll; tooltip-text: strings.tip-auto-scroll; checked <=> root.auto-scroll; }
                            Button { text: strings.button-save-log; tooltip-text: strings.tip-save-log; clicked => { root.save-log(); } }
                        }
                    }
                }
            }
        }

        // ---- 底部：开始/停止、语言、关于（右） ----
        HorizontalLayout {
            alignment: end;
            spacing: 10px;
            // 弹性占位：把右侧按钮组推回右端
            Rectangle { horizontal-stretch: 1; }
            Button { text: strings.button-start; enabled: !root.encoding && root.controls-enabled; min-width: 100px; tooltip-text: strings.tip-start; clicked => { root.start-encode(); } }
            Button { text: strings.button-stop; enabled: root.encoding; min-width: 100px; tooltip-text: strings.tip-stop; clicked => { root.stop-encode(); } }
            ComboBox {
                width: 90px;
                model: ["中文", "English"];
                tooltip-text: strings.tip-language;
                current-index <=> root.language-index;
                selected => { root.language-changed(root.language-index); }
            }
            Button { text: strings.button-about; tooltip-text: strings.tip-about; clicked => { root.show-about(); } }
        }

        } // ---- 主体 VerticalBox 结束 ----

        // ---- 预览列 ----
        // 收起时宽度为 0，完全不占地方；展开后从主体右边缘往右铺开。
        Rectangle {
            x: root.main-w;
            y: 0px;
            width: root.preview-expanded ? root.preview-w : 0px;
            height: parent.height;
            clip: true;
            background: Palette.background;

            VerticalBox {
                padding-left: root.video-pad;
                padding-right: root.video-pad;
                // 上下边距都取算出来的居中位置：两边一样，块才落在面板正中，
                // 而且不留余量给布局去摊
                padding-top: root.preview-top;
                padding-bottom: root.preview-top;
                spacing: root.preview-gap;

                // 画面：外圈一层 1px 灰边，里面是画帧。宽高按视频真实比例算。
                // 外面套一层 HorizontalLayout 是为了水平居中：VerticalBox 里固定宽度的
                // 子元素是靠左摆的，而 video-x 按居中算，不套这一层两者会差出半个余量，
                // 4:3 这类窄画面下就能看到边框和面板中心错开一条边。
                HorizontalLayout {
                    vertical-stretch: 0;
                    alignment: center;
                    // 1px 灰边，颜色和宽度都跟设置页的内边框一致。
                    Rectangle {
                        width: root.video-w + root.video-frame * 2;
                        height: root.video-h + root.video-frame * 2;
                        border-width: 1px;
                        border-color: #E0E0E0;
                        // 黑底留着：还没加载文件、或者解码出的画帧比例和探测到的
                        // 不一致时（contain 会留边），露出来的就是它
                        background: #000000;

                        Image {
                            x: root.video-frame;
                            y: root.video-frame;
                            width: root.video-w;
                            height: root.video-h;
                            source: root.preview-frame;
                            // 后端固定按 640×360 出帧，宽高比交给这里兜
                            image-fit: contain;
                        }
                    }
                }

                // 进度条：拖到哪跳到哪，松手才 seek，拖动过程中不打断预览
                Slider {
                    value <=> root.preview-seek-1000;
                    minimum: 0;
                    maximum: 1000;
                    step: 1;
                    enabled: root.preview-controls-on;
                    // 高度写死，preview-controls-h 那个常数才能对得上
                    height: root.slider-h;
                    // changed 只在用户操作时触发（app.rs 写属性不会触发），
                    // 所以拿它当"正在拖"的信号是安全的。
                    changed(v) => { root.preview-scrubbing = true; }
                    released(v) => { root.preview-scrubbing = false; root.preview-seek(v / 1000); root.focus-preview-keys(); }
                }

                // 第一行：当前时间/总时长 | 播放控件 | 音量 静音 | 当前帧/总帧数
                // 左右两段宽度写死成一样，中间那组图标按钮才是真正居中的
                // （都用 stretch 的话，两边内容宽度不同，中间就会被挤偏）。
                HorizontalLayout {
                    spacing: 8px;
                    min-height: root.control-row-h;
                    vertical-stretch: 0;

                    Text {
                        width: root.preview-side-w;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        font-family: "Consolas";
                        font-size: 11px;
                        color: root.preview-loaded ? Palette.foreground : #909090;
                        text: root.preview-time-text + " / " + root.preview-duration-text;
                    }

                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;

                        IconButton {
                            icon: @image-url("icons/skip-start.svg");
                            enabled: root.preview-controls-on;
                            tooltip-text: strings.tip-goto-start;
                            clicked => { root.preview-goto-start(); }
                        }
                        IconButton {
                            icon: @image-url("icons/step-back.svg");
                            enabled: root.preview-controls-on;
                            tooltip-text: strings.tip-step-back;
                            clicked => { root.preview-step(-1); }
                        }
                        IconButton {
                            icon: root.preview-paused
                                ? @image-url("icons/play.svg")
                                : @image-url("icons/pause.svg");
                            enabled: root.preview-controls-on;
                            tooltip-text: root.preview-paused ? strings.button-play : strings.button-pause;
                            clicked => { root.preview-toggle-play(); }
                        }
                        IconButton {
                            icon: @image-url("icons/step-forward.svg");
                            enabled: root.preview-controls-on;
                            tooltip-text: strings.tip-step-forward;
                            clicked => { root.preview-step(1); }
                        }
                        IconButton {
                            icon: @image-url("icons/skip-end.svg");
                            enabled: root.preview-controls-on;
                            tooltip-text: strings.tip-goto-end;
                            clicked => { root.preview-goto-end(); }
                        }
                    }

                    // 右段：音量条 + 静音键 + 帧数。帧数右对齐贴着面板右边，
                    // 所以给它 stretch 把余量吃掉，不加多余的占位矩形。
                    HorizontalLayout {
                        width: root.preview-side-w;
                        spacing: 6px;

                        // 音量条包一层：里面要挂一层接鼠标的 TouchArea 和浮出来的
                        // 数字，这两个都不能直接放进布局（布局会把它们当成要排布的
                        // 元素）。宽度还是音量条那个宽度，外面看着没差别。
                        Rectangle {
                            width: root.volume-slider-w;

                            // 这层只负责画。鼠标事件被上面的 vol-touch 接走了，
                            // 所以它自己收不到拖动，值由 vol-touch 写进来。
                            Slider {
                                width: 100%;
                                // 高度跟着行高走，不写死 20px。横向布局的交叉轴是按
                                // stretch 解的，固定高度的元素会被顶到行的上沿，看着
                                // 比旁边的图标键高一截；撑满行高之后，滑块自己会把
                                // 轨道和拇指居中。
                                height: 100%;
                                value <=> root.preview-volume;
                                minimum: 0;
                                maximum: 100;
                                enabled: root.preview-controls-on;
                            }

                            // 悬停或拖动时，在音量条上方浮一个数字。x/y 自己算，
                            // 不占布局的位置。
                            if (vol-touch.has-hover || root.preview-vol-dragging): Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: -self.height - 2px;
                                width: vol-text.width + 10px;
                                height: vol-text.height + 4px;
                                border-radius: 3px;
                                background: FluentPalette.alternate-background;
                                border-width: 1px;
                                border-color: FluentPalette.border;

                                vol-text := Text {
                                    x: 5px;
                                    y: 2px;
                                    text: "\{round(root.preview-volume)}";
                                    font-family: "Consolas";
                                    font-size: 11px;
                                    color: FluentPalette.foreground;
                                }
                            }

                            // 盖在滑块上的 TouchArea：一是拿 has-hover 知道鼠标停在
                            // 音量条上没有（滑块自己的悬停状态外面读不到），二是它
                            // 盖上去之后滑块就收不到事件了，拖动只能在这里算。
                            // 拇指宽 20px、中心在 10px..(宽-10px) 之间走，把鼠标的
                            // x 按这个范围换算成 0..100，取整后和浮出来的数字对得上。
                            //
                            // 每动一下要做两件事：改 preview-volume（滑块和浮出来的
                            // 数字看的是它）和发 preview-set-volume（那个回调一路送到
                            // 音频线程）。拖动期间 app.rs 不回写 preview-volume，
                            // 光发回调的话滑块会一直停在旧值上。
                            vol-touch := TouchArea {
                                enabled: root.preview-controls-on;
                                // 算一次放这儿，down 和 moved 里都读它
                                property <float> value-from-x: round(clamp(
                                    (self.mouse-x - 10px) / (root.volume-slider-w - 20px) * 100,
                                    0, 100));

                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.up
                                        || e.kind == PointerEventKind.cancel) {
                                        // cancel 是拖到一半控件被禁用，别把 dragging 卡住
                                        root.preview-vol-dragging = false;
                                    } else if (e.kind == PointerEventKind.down
                                               && e.button == PointerEventButton.left) {
                                        root.preview-vol-dragging = true;
                                        root.preview-volume = self.value-from-x;
                                        root.preview-set-volume(self.value-from-x);
                                    }
                                }
                                // 只在按住时才触发（见 TouchArea.moved 的说明）
                                moved => {
                                    root.preview-volume = self.value-from-x;
                                    root.preview-set-volume(self.value-from-x);
                                }
                            }
                        }

                        IconButton {
                            icon: root.preview-muted
                                ? @image-url("icons/volume-muted.svg")
                                : @image-url("icons/volume.svg");
                            enabled: root.preview-controls-on;
                            tooltip-text: root.preview-muted ? strings.button-unmute : strings.button-mute;
                            clicked => { root.preview-toggle-mute(); }
                        }

                        Text {
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            font-family: "Consolas";
                            font-size: 11px;
                            color: root.preview-loaded ? Palette.foreground : #909090;
                            text: root.preview-frame-cur + " / " + root.preview-frame-total;
                        }
                    }
                }

                // 第二行：设为开头 | 设为结尾 | 空白 | 帧号框 | 时间戳框 | 跳转
                // 按钮不写 horizontal-stretch，让它们各自贴着文字那么宽
                // （fluent-lite 的 Button 自带左右各 12px 内边距，这就是最紧凑的形状）。
                HorizontalLayout {
                    spacing: 6px;
                    min-height: root.control-row-h;
                    vertical-stretch: 0;

                    Button {
                        text: strings.button-set-start;
                        enabled: root.preview-controls-on;
                        tooltip-text: strings.tip-set-start;
                        clicked => { root.preview-set-trim-start(); root.focus-preview-keys(); }
                    }

                    Button {
                        text: strings.button-set-end;
                        enabled: root.preview-controls-on;
                        tooltip-text: strings.tip-set-end;
                        clicked => { root.preview-set-trim-end(); root.focus-preview-keys(); }
                    }

                    // 空白：把后面那组输入框顶到右端
                    Rectangle { horizontal-stretch: 1; }

                    // 帧率探不出来时这个框没法换算，直接禁用
                    // 两个框都不抢富余宽度，让中间的空白独占，框才是刚好装下内容的宽度
                    LineEdit {
                        min-width: 74px;
                        horizontal-stretch: 0;
                        text <=> root.preview-frame-input;
                        enabled: root.preview-fps-known && root.preview-controls-on;
                        tooltip-text: strings.tip-frame-input;
                        edited(t) => { root.preview-frame-edited(t); }
                    }

                    LineEdit {
                        min-width: 134px;
                        horizontal-stretch: 0;
                        text <=> root.preview-time-input;
                        enabled: root.preview-controls-on;
                        tooltip-text: strings.tip-time-input;
                        edited(t) => { root.preview-time-edited(t); }
                    }

                    Button {
                        text: strings.button-jump;
                        enabled: root.preview-controls-on;
                        tooltip-text: strings.tip-jump;
                        clicked => { root.preview-jump-to-input(); root.focus-preview-keys(); }
                    }
                }
            }
        }

        // ---- 展开/收起按钮：窄长竖条，骑在主体右边缘、竖直居中 ----
        // 勾上「裁剪视频」后整条变蓝（配色和 150ms 过渡都跟复选框选中一样），
        // 提醒这会儿预览是用来挑裁剪范围的。
        expand-btn := Rectangle {
            visible: root.preview-available;
            x: root.main-w - self.width;
            // 吸附到设备像素网格。窗口高 544px，不吸附的话这条按钮的上下边落在
            // 半个设备像素上（125% 下 222 逻辑 = 277.5 物理），1px 的上下边线
            // 被摊成两行半亮，看着像没有边；左右边正好落在整像素上所以是实的。
            y: FluentMetrics.snap((root.height - self.height) / 2);
            width: 20px;
            height: 100px;
            background: root.trim-enabled
                ? (expand-touch.pressed ? FluentPalette.tertiary-accent-background
                    : expand-touch.has-hover ? FluentPalette.secondary-accent-background
                    : FluentPalette.accent-background)
                : (expand-touch.has-hover ? #DCE9F7 : #F2F2F2);
            border-width: 1px;
            // 灰边两种状态都用，变蓝之后也留着
            border-color: #C8C8C8;
            border-radius: 3px;

            animate background { duration: 150ms; }

            expand-touch := TouchArea {
                clicked => { root.preview-toggle-expanded(); }
            }

            Image {
                width: 10px;
                height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: root.trim-enabled ? #FFFFFF : #5A5A5A;
                source: root.preview-expanded
                    ? @image-url("chevron-left.svg")
                    : @image-url("chevron-right.svg");

                animate colorize { duration: 150ms; }
            }
        }

        // 按钮的悬停提示。没用内建的 Tooltip：那个按鼠标位置弹，会盖住画面区。
        // 这里固定画在按钮左侧，落点是设置面板，两种状态下都完整可见。
        Rectangle {
            visible: root.preview-available && expand-touch.has-hover;
            x: expand-btn.x - self.width - 6px;
            y: expand-btn.y + (expand-btn.height - self.height) / 2;
            width: btn-tip-text.width + 18px;
            height: btn-tip-text.height + 12px;
            background: Palette.alternate-background;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.border;

            btn-tip-text := Text {
                x: 9px;
                y: 6px;
                text: root.preview-expanded
                    ? strings.tip-preview-collapse
                    : strings.tip-preview-expand;
                font-size: 12px;
                color: Palette.foreground;
            }
        }
    }
}
