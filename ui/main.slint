import { Button, LineEdit, ComboBox, CheckBox, TabWidget, RadioGroup, ListView, HorizontalBox, VerticalBox, Palette } from "std-widgets.slint";

// FluentMetrics 定义在 fluent-lite/styling.slint，这里再导出一次，Rust 侧才能通过
// crate::FluentMetrics 写它里面的 device-pixel-ratio。
import { FluentMetrics } from "fluent-lite/styling.slint";
export { FluentMetrics }

// 全部 UI 文本（随语言切换由 Rust 端一次性更新）
export struct UiStrings {
    tab-video: string,
    tab-log: string,
    label-input: string,
    label-output: string,
    button-browse: string,
    label-format: string,
    format-tip: string,
    label-method: string,
    label-resolution: string,
    label-width: string,
    label-height: string,
    check-scale-up: string,
    check-extract-audio: string,
    button-start: string,
    button-stop: string,
    check-auto-scroll: string,
    button-save-log: string,
    button-about: string,
    button-open-folder: string,
    // ---- 音频模式 ----
    label-audio-mode: string,
    audio-none: string,
    audio-copy: string,
    audio-transcode: string,
    label-audio-codec: string,
    // ---- 视频裁剪 ----
    check-trim: string,
    label-trim-unit: string,
    trim-frames: string,
    trim-time: string,
    label-trim-range: string,
    label-trim-start: string,
    label-trim-end: string,
    // ---- 悬停工具提示 ----
    tip-browse-input: string,
    tip-browse-output: string,
    tip-start: string,
    tip-stop: string,
    tip-about: string,
    tip-open-folder: string,
    tip-save-log: string,
    tip-format: string,
    tip-language: string,
    tip-scale-up: string,
    tip-extract-audio: string,
    tip-auto-scroll: string,
    tip-audio-mode: string,
    tip-audio-codec: string,
    tip-trim: string,
    tip-trim-unit: string,
    tip-trim-start: string,
    tip-trim-end: string,
    // 文本框 / 单选框 / 标签
    tip-input-path: string,
    tip-output-path: string,
    tip-value: string,
    tip-width: string,
    tip-height: string,
    tip-method: string,
    tip-resolution: string,
}

// 日志面板。滚动由 Rust 端驱动：启用自动滚动时在追加日志后把
// viewport-y 设为内容底部；关闭后不干预，用户可自由滚动。
// 用 ListView 逐行渲染，而不是「ScrollView + 单个 Text」：Slint 1.17 里
// ScrollView 内元素的宽度一旦绑定到视口宽度就形成绑定环，内容被钳制到
// 可视区、永远不溢出 → 没有滚动条，滚动与自动滚动全部失效。
// ListView 每行独立布局（占满全宽、自动换行），视口高度随行数正确增长。
component LogView inherits VerticalLayout {
    in property <[string]> log-lines;
    in property <bool> auto-scroll: true;

    in-out property <length> viewport-y <=> i-scroll-view.viewport-y;
    out property <length> viewport-height <=> i-scroll-view.viewport-height;
    out property <length> visible-height <=> i-scroll-view.visible-height;

    // 由 Rust 端在追加日志且启用自动滚动时调用（滚动到底部）
    callback scroll-to-end();

    i-scroll-view := ListView {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        for line in root.log-lines: Text {
            text: line;
            wrap: word-wrap;
            font-family: "Consolas";
            font-size: 11px;
        }
    }

    scroll-to-end => {
        // Flickable 的 viewport-y 向下为负（运行时取 -viewport-y 作为滚动偏移），
        // 所以到底部要写负值；写成正值会被钳制回顶部，导致“自动滚动”无效。
        i-scroll-view.viewport-y = -(i-scroll-view.viewport-height - i-scroll-view.visible-height);
    }
}

// 细线：分组分隔线和进度条描边共用同一条。页面底色是 #f0f0f0，
// 这个色只深 8 个色阶，是那种不凑近看几乎注意不到的灰。
global ThinLine {
    out property <color> color: #E8E8E8;
    out property <length> width: 1px;
}

// 分组分隔线，用来把主页的选项分成「文件 / 编码 / 音频 / 裁剪 / 其它」几组。
// 自身 10.6px 高、线画在中间，配合外层 2.4px 的行距，每组之间上下各留 7.2px
// （就是原来各 4px + 2px 的 1.2 倍）。
component GroupSeparator inherits Rectangle {
    height: 10.6px;
    background: transparent;

    Rectangle {
        y: 4.8px;
        width: parent.width;
        height: ThinLine.width;
        background: ThinLine.color;
    }
}

// 自定义进度条：轨道与填充同高（12px，对齐 WPF <ProgressBar Height="12">）。
// std-widgets 的 ProgressIndicator 内部轨道硬编码 1px，加粗后轨道与填充高度不匹配，
// 故自定义为全高轨道框 + 同高填充，颜色沿用 FluentPalette 保持一致。
component ThickProgressBar {
    in property <float> progress;

    height: 12px;
    horizontal-stretch: 1;

    Rectangle {
        // 轨道（背景框）：纯白底，外圈一条 1px 细描边，用分组分隔线同款的
        // ThinLine。#F0F0F0 那种颜色跟页面底色一样，等于没有边。
        background: #FFFFFF;
        border-radius: 3px;
        border-width: ThinLine.width;
        border-color: ThinLine.color;
        clip: true;

        // 填充：宽度随进度变化，向内缩 1px 避开黑色边框（高度同减），
        // 颜色用 Windows/VS Code 默认蓝 #0078D4。
        Rectangle {
            x: 1px;
            y: 1px;
            width: (parent.width - 2px) * min(1.0, max(0.0, root.progress));
            height: parent.height - 2px;
            background: #0078D4;
        }
    }
}

// 带圈 i 提示按钮：悬停时圈和文字轻微亮起；点击才弹出 osu! 格式建议气泡。
// 对应旧程序 MainWindow.xaml 中 FormatBox 右侧的提示句柄
// （Grid + Ellipse + "i"，ToolTipService.InitialShowDelay=0）。
// 气泡位置按点击点计算并右下方偏移 16px，避开鼠标指针；
// 任意位置点击（close-on-click）或 15 秒后自动隐藏。
component FormatTip inherits Rectangle {
    in property <string> tip-text;

    width: 16px;
    height: 16px;

    // 圈 + i 图标（悬停或气泡打开时轻微亮起：填充变亮、边框与文字泛蓝）
    Rectangle {
        border-radius: 8px;
        border-width: 1.2px;
        border-color: touch.has-hover || tip.is-open ? #0078D4 : #7F7F7F;
        background: touch.has-hover || tip.is-open ? #E3F2FD : #CFCFCF;
        Text {
            text: "i";
            font-weight: 700;
            font-size: 11px;
            color: touch.has-hover || tip.is-open ? #0078D4 : #5A5A5A;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 记录点击时的鼠标位置作为气泡锚点。不能直接绑定 touch.mouse-x，
    // 否则气泡会跟着鼠标移动，无法“避开鼠标”。
    property <length> popup-x: 0px;
    property <length> popup-y: 0px;

    // 不可见焦点清除目标：宽度 0、不参与点击与 Tab 遍历，仅作 `focus()` 接收端，
    // 让正在编辑的文本框在点击此控件时失焦（与其它可点击控件保持一致）。
    focus-blank := FocusScope {
        x: 0;
        width: 0;
        height: 0;
        focus-on-click: false;
        focus-on-tab-navigation: false;
    }

    // 按钮交互：悬停仅驱动亮起（has-hover）；点击切换气泡显示
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus-blank.focus();
            if tip.is-open {
                tip.close();
            } else {
                popup-x = self.pressed-x + 16px;
                popup-y = self.pressed-y + 16px;
                tip.show();
                close-timer.running = false;
                close-timer.running = true;
            }
        }
    }

    // 提示气泡：锚定在点击位置右下方，避开鼠标
    tip := PopupWindow {
        close-policy: close-on-click;
        x: popup-x;
        y: popup-y;
        width: tip-content.preferred-width;
        height: tip-content.preferred-height;
        tip-content := Rectangle {
            background: #FFFFFF;
            border-width: 1px;
            border-color: #C0C0C0;
            border-radius: 4px;
            VerticalBox {
                padding: 8px;
                Text {
                    text: root.tip-text;
                    wrap: word-wrap;
                    width: 260px;
                    font-size: 11px;
                    color: #333333;
                }
            }
        }
    }

    // 15 秒自动隐藏（一次性定时器）
    close-timer := Timer {
        interval: 15000ms;
        running: false;
        triggered => {
            self.running = false;
            tip.close();
        }
    }
}

// 带悬停工具提示的字段标签。提示触发区 = 标签文字本身；Tooltip 必须排在
// 组件的其它指针目标之后（这里就是最后一个子元素），TooltipArea 才能收到鼠标事件。
component TippableLabel inherits Text {
    in property <string> tip: "";

    if (root.tip != ""): Tooltip {
        Rectangle {
            background: Palette.alternate-background;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                padding-left: 9px;
                padding-right: 9px;
                padding-top: 6px;
                padding-bottom: 6px;
                Text { text: root.tip; font-size: 12px; color: Palette.foreground; }
            }
        }
    }
}

// 编码方法单选行。RadioButton 是编译器内建伪元素，类型检查不允许自定义属性
// （tooltip-text 会在 lowering 前报 Unknown property），单选项 tooltip 不可行；
// 故把整行（RadioGroup）作为提示触发区：Tooltip 排在 RadioGroup 之后即最上层，
// 悬停任一选项都能看到同一说明，点击仍正常透传。
component MethodRadioRow {
    in property <string> tip;
    callback selected(string);

    // 隐式根是裸 Rectangle：preferred=0 / stretch=1，放在布局里会被撑满整行，
    // RadioGroup 内部的 GridLayout 把两个单选按钮居中到窗口中间。显式把根尺寸
    // 绑到 RadioGroup 的内容尺寸（min-width/min-height），保持紧凑靠左。
    width: rg.min-width;
    height: rg.min-height;

    rg := RadioGroup {
        orientation: horizontal;
        selected(text) => { root.selected(text); }
        RadioButton { text: "CRF"; checked: true; }
        RadioButton { text: "2pass"; }
    }

    if (root.tip != ""): Tooltip {
        Rectangle {
            background: Palette.alternate-background;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                padding-left: 9px;
                padding-right: 9px;
                padding-top: 6px;
                padding-bottom: 6px;
                Text { text: root.tip; font-size: 12px; color: Palette.foreground; }
            }
        }
    }
}

// 裁剪单位单选行。写法和限制与 MethodRadioRow 相同（RadioButton 是编译器内建
// 伪元素，不支持自定义属性，所以 tooltip 挂在整行上）。
// RadioButton 的 text 既是显示文本也是 selected() 回传值，没有独立的值字段，
// 因此这里传本地化文本，Rust 侧拿当前语言的字符串比对来判断选的是哪一项。
component TrimUnitRow {
    in property <string> tip;
    in property <string> frames-text;
    in property <string> time-text;
    // 组件不是内建控件，enabled 不是内建属性，要自己声明再转给 RadioGroup
    in property <bool> enabled: true;
    callback selected(string);

    width: rg.min-width;
    height: rg.min-height;

    rg := RadioGroup {
        enabled: root.enabled;
        orientation: horizontal;
        selected(text) => { root.selected(text); }
        RadioButton { text: root.frames-text; checked: true; }
        RadioButton { text: root.time-text; }
    }

    if (root.tip != ""): Tooltip {
        Rectangle {
            background: Palette.alternate-background;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                padding-left: 9px;
                padding-right: 9px;
                padding-top: 6px;
                padding-bottom: 6px;
                Text { text: root.tip; font-size: 12px; color: Palette.foreground; }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "x264video4osu";
    // 使用系统原生标题栏。尺寸按语言分两套：中文标签短，窗口更窄；英文标签长，留宽一点。
    // label-col-w 是左侧标签列宽度，实测中文最长标签 48px、英文 70px，各留几像素余量。
    // app.rs 的 DPI 修正直接读这两个属性，不重复写死。
    out property <length> label-col-w: root.language-index == 0 ? 52px : 78px;
    out property <length> window-w: root.language-index == 0 ? 440px : 520px;
    // 「音频模式」下拉框要放下最长的选项（英文 "Copy audio stream" 实测 101px，
    // 加上下拉框自身左右各 11px 内边距和 20px 箭头 ≈ 143px），中文短一些。
    out property <length> audio-combo-w: root.language-index == 0 ? 112px : 150px;
    width: root.window-w;
    height: root.window-h;
    // 高度按内容实测：Video 页内容加底部按钮栏最少约 475px，留一点余量。
    // 再多出来的高度会进页面里的弹性占位，所以不用卡得很死。
    // 竖直间距改成 1.2 倍后总共长了约 18px，跟着加，不然最后一行会被裁掉。
    out property <length> window-h: 524px;
    background: Palette.background;

    in property <UiStrings> strings;


    // ---------- 输入数据 ----------
    in-out property <string> input-path: "";
    in-out property <string> output-path: "";
    in-out property <int> format-index: 0;
    in property <int> mode-index: 0;          // 0 = CRF, 1 = 2pass（Rust 端跟踪）
    in-out property <string> value-text: "26";
    in-out property <string> width-text: "0";
    in-out property <string> height-text: "720";
    in-out property <bool> scale-up: false;
    in-out property <bool> extract-audio: false;
    // ---------- 音频 / 裁剪 ----------
    in-out property <int> audio-mode-index: 0;      // 0 = 无音频, 1 = 复制音频流, 2 = 转码音频
    in-out property <int> audio-codec-index: 0;     // 0 = AAC, 1 = FLAC（仅 mp4）
    // FLAC 只在 mp4 下可选：非 mp4 时下拉框只有 AAC 一项
    in property <[string]> codec-model: root.format-index == 2 ? ["AAC", "FLAC"] : ["AAC"];
    in-out property <bool> trim-enabled: false;
    in-out property <string> trim-start-text: "";
    in-out property <string> trim-end-text: "";
    in property <bool> encoding: false;
    in property <bool> controls-enabled: true;
    in-out property <int> language-index: 0;

    // ---------- 进度 / 结果 ----------
    in property <bool> progress-visible: false;
    in property <bool> result-visible: false;
    in property <float> progress-value: 0.0;   // 0..1
    in property <string> pass-text: "";
    in property <string> percent-text: "";
    in property <string> eta-text: "";
    in property <string> elapsed-text: "";
    in property <string> output-size-text: "";

    // 进度数据文字颜色：非运行灰色，编码时黑色
    property <color> progress-text-color: root.encoding ? #000000 : #909090;

    // ---------- 日志 ----------
    in property <[string]> log-lines: [];
    in-out property <bool> auto-scroll: true;

    // ---------- 回调 ----------
    callback browse-input();
    callback browse-output();
    callback start-encode();
    callback stop-encode();
    callback open-folder();
    callback save-log();
    callback show-about();
    callback language-changed(int);
    callback format-changed(int);
    callback mode-changed(string);
    callback trim-unit-changed(string);
    callback scroll-log-to-end();

    // 转发给日志组件，供 Rust 端在自动滚动时调用
    scroll-log-to-end => { log-view.scroll-to-end(); }

    // 根容器：普通 Rectangle（非布局），子元素用绝对坐标摆放。
    // 窗口用系统原生标题栏，主体 VerticalBox 铺满整个窗口。
    base := Rectangle {
        width: parent.width;
        height: parent.height;

        // ---- 全局背景 FocusScope ----
        // Slint 默认点击空白区域不会清除焦点（只有点其它文本框才会切换焦点）。
        // 在窗口最底层放一个铺满窗口的 FocusScope，点击非交互区域（空白、标签、
        // 面板背景等）时它自动夺取焦点，让正在编辑的文本框失焦。
        // 必须是最底层（第一个子元素）：其它控件先拿到点击时它不参与，不干扰交互。
        // focus-on-tab-navigation 关掉，避免在 Tab 焦点链里多出一个不可见停靠点。
        bg-focus := FocusScope {
            width: parent.width;
            height: parent.height;
            focus-on-tab-navigation: false;
        }

        // ---- 主体内容 ----
        VerticalBox {
            y: 0px;
            width: parent.width;
            height: parent.height;
            // 竖直方向的间距统一放大到 1.2 倍（原来 padding 6px / spacing 3px），
            // 左右不动，只调上下。
            padding-left: 6px;
            padding-right: 6px;
            padding-top: 7.2px;
            padding-bottom: 7.2px;
            spacing: 3.6px;

        TabWidget {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            Tab { title: strings.tab-video;
                Rectangle {
                    background: Palette.alternate-background;
                    border-width: 1px;
                    // 页面内边框用 WPF 原版的极浅 1px 细线 #E0E0E0（而非 palette 的深灰）
                    border-color: #E0E0E0;
                    border-radius: 4px;
                    VerticalBox {
                        // 左右各 10px：原来和后边距一样的 6px 让文字几乎贴着页面内边框。
                        // 上下按 1.2 倍放大（原来各 6px），行距同样 1.2 倍（原来 2px）。
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 7.2px;
                        padding-bottom: 7.2px;
                        spacing: 2.4px;

                        // ---- 输入文件 ----
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            TippableLabel { text: strings.label-input; tip: strings.tip-input-path; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            LineEdit { horizontal-stretch: 1; min-width: 240px; text <=> root.input-path; tooltip-text: strings.tip-input-path; }
                            Button { text: strings.button-browse; min-width: 50px; tooltip-text: strings.tip-browse-input; clicked => { root.browse-input(); } }
                        }

                        // ---- 输出文件 ----
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            TippableLabel { text: strings.label-output; tip: strings.tip-output-path; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            LineEdit { horizontal-stretch: 1; min-width: 240px; text <=> root.output-path; tooltip-text: strings.tip-output-path; }
                            Button { text: strings.button-browse; min-width: 50px; tooltip-text: strings.tip-browse-output; clicked => { root.browse-output(); } }
                        }

                        GroupSeparator { }

                        // ---- 输出格式 ----
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            TippableLabel { text: strings.label-format; tip: strings.tip-format; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            ComboBox { width: 80px; model: ["flv", "avi", "mp4"]; tooltip-text: strings.tip-format; current-index <=> root.format-index; selected => { root.format-changed(root.format-index); } }
                            FormatTip { tip-text: strings.format-tip; }
                            // 每行末尾都要有一个弹性占位吸收剩余宽度。标签用的是 min-width
                            // （不是固定 width），行里没人吸收余量时 Slint 会把余量摊给所有
                            // 子元素，标签列就会被撑宽、跟别的行对不齐。
                            Rectangle { horizontal-stretch: 1; }
                        }

                        // ---- 编码方式 ----
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            TippableLabel { text: strings.label-method; tip: strings.tip-method; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            MethodRadioRow { tip: strings.tip-method; selected(text) => { root.mode-changed(text); } }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        // ---- 数值框（2pass 码率 / CRF 质量） ----
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { min-width: root.label-col-w; horizontal-stretch: 0; }
                            LineEdit { width: 80px; text <=> root.value-text; tooltip-text: strings.tip-value; }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        // ---- 分辨率 ----
                        // LineEdit 默认 horizontal-stretch:1 / min-width:160px，放进行内会拉满整行、
                        // 把 caption 撑开。这里固定输入框宽度（70px，可容纳 5 位数）并禁止拉伸。
                        // 「宽度」标签与上面输入框的起始列对齐（紧跟 90px 标签列），输入框紧贴其后；
                        // 剩余横向空间按 45%:55% 分割，在约 45% 处放入「高度」+ 高度输入框。
                        HorizontalLayout {
                            vertical-stretch: 0;
                            // 与上面各行的 spacing:4px 一致，保证「宽度」跟输入框的起始列对齐
                            spacing: 4px;
                            TippableLabel { text: strings.label-resolution; tip: strings.tip-resolution; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            HorizontalLayout {
                                spacing: 3px;
                                TippableLabel { text: strings.label-width; tip: strings.tip-width; vertical-alignment: center; }
                                LineEdit { min-width: 70px; horizontal-stretch: 0; text <=> root.width-text; tooltip-text: strings.tip-width; }
                            }
                            Rectangle { horizontal-stretch: 45; }
                            HorizontalLayout {
                                spacing: 3px;
                                TippableLabel { text: strings.label-height; tip: strings.tip-height; vertical-alignment: center; }
                                LineEdit { min-width: 70px; horizontal-stretch: 0; text <=> root.height-text; tooltip-text: strings.tip-height; }
                            }
                            Rectangle { horizontal-stretch: 55; }
                        }

                        GroupSeparator { }

                        // ---- 音频模式 ----
                        // 「转码音频」时才在同行右侧露出「音频编码」下拉框；FLAC 只在 mp4 下可选。
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            TippableLabel { text: strings.label-audio-mode; tip: strings.tip-audio-mode; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            ComboBox {
                                width: root.audio-combo-w;
                                model: [strings.audio-none, strings.audio-copy, strings.audio-transcode];
                                tooltip-text: strings.tip-audio-mode;
                                current-index <=> root.audio-mode-index;
                            }
                            if (root.audio-mode-index == 2): TippableLabel { text: strings.label-audio-codec; tip: strings.tip-audio-codec; vertical-alignment: center; }
                            if (root.audio-mode-index == 2): ComboBox {
                                width: 80px;
                                model: root.codec-model;
                                tooltip-text: strings.tip-audio-codec;
                                current-index <=> root.audio-codec-index;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        GroupSeparator { }

                        // ---- 视频裁剪 ----
                        // 复选框和标签列左对齐，不再像原来那样再缩进 10px
                        // 未勾选时下面两行整体置灰（enabled 会向子元素传递），也不参与编码。
                        HorizontalLayout {
                            CheckBox { vertical-stretch: 0; text: strings.check-trim; tooltip-text: strings.tip-trim; checked <=> root.trim-enabled; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            TippableLabel { text: strings.label-trim-unit; tip: strings.tip-trim-unit; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            TrimUnitRow {
                                tip: strings.tip-trim-unit;
                                frames-text: strings.trim-frames;
                                time-text: strings.trim-time;
                                enabled: root.trim-enabled;
                                selected(text) => { root.trim-unit-changed(text); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            TippableLabel { text: strings.label-trim-range; tip: strings.tip-trim-start; min-width: root.label-col-w; horizontal-stretch: 0; vertical-alignment: center; }
                            TippableLabel { text: strings.label-trim-start; tip: strings.tip-trim-start; vertical-alignment: center; }
                            LineEdit { min-width: 110px; horizontal-stretch: 0; enabled: root.trim-enabled; text <=> root.trim-start-text; tooltip-text: strings.tip-trim-start; }
                            Rectangle { horizontal-stretch: 1; }
                            TippableLabel { text: strings.label-trim-end; tip: strings.tip-trim-end; vertical-alignment: center; }
                            LineEdit { min-width: 110px; horizontal-stretch: 0; enabled: root.trim-enabled; text <=> root.trim-end-text; tooltip-text: strings.tip-trim-end; }
                        }

                        GroupSeparator { }

                        // ---- 复选项（和上面的标签列左对齐，不再额外缩进） ----
                        HorizontalLayout {
                            CheckBox { vertical-stretch: 0; text: strings.check-scale-up; tooltip-text: strings.tip-scale-up; checked <=> root.scale-up; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            CheckBox { vertical-stretch: 0; text: strings.check-extract-audio; tooltip-text: strings.tip-extract-audio; checked <=> root.extract-audio; }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        // ---- 弹性占位：吸收富余高度，让设置行保持紧凑不拉伸 ----
                        Rectangle { vertical-stretch: 1; }

                        // ---- 结果面板（编码结束后显示，置底） ----
                        if (root.result-visible): HorizontalLayout {
                            spacing: 8px;
                            Text { text: root.output-size-text; vertical-alignment: center; }
                            Button { text: strings.button-open-folder; tooltip-text: strings.tip-open-folder; clicked => { root.open-folder(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        // ---- 进度面板：常驻显示，固定在标签页最底部 ----
                        VerticalLayout {
                            spacing: 4px;
                            // 高度 12px，对齐旧程序 MainWindow.xaml 中 <ProgressBar Height="12">
                            ThickProgressBar { progress: root.progress-value; }
                            HorizontalLayout {
                                spacing: 6px;
                                Text { text: root.pass-text; width: 60px; vertical-alignment: center; color: root.progress-text-color; }
                                Text { text: root.percent-text; width: 60px; vertical-alignment: center; color: root.progress-text-color; }
                                Text { text: root.eta-text; width: 80px; vertical-alignment: center; color: root.progress-text-color; }
                                Text { text: root.elapsed-text; horizontal-stretch: 1; vertical-alignment: center; color: root.progress-text-color; }
                            }
                        }
                    }
                }
            }

            Tab { title: strings.tab-log;
                Rectangle {
                    background: Palette.alternate-background;
                    border-width: 1px;
                    // 页面内边框用 WPF 原版的极浅 1px 细线 #E0E0E0
                    border-color: #E0E0E0;
                    border-radius: 4px;
                    VerticalBox {
                        // 同样按 1.2 倍放大竖直方向的间距（原来上下各 8px、行距 6px）
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 9.6px;
                        padding-bottom: 9.6px;
                        spacing: 7.2px;
                        log-view := LogView {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            log-lines: root.log-lines;
                            auto-scroll: root.auto-scroll;
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 10px;
                            CheckBox { text: strings.check-auto-scroll; tooltip-text: strings.tip-auto-scroll; checked <=> root.auto-scroll; }
                            Button { text: strings.button-save-log; tooltip-text: strings.tip-save-log; clicked => { root.save-log(); } }
                        }
                    }
                }
            }
        }

        // ---- 底部：开始/停止、语言、关于（右） ----
        HorizontalLayout {
            alignment: end;
            spacing: 10px;
            // 弹性占位：把右侧按钮组推回右端
            Rectangle { horizontal-stretch: 1; }
            Button { text: strings.button-start; enabled: !root.encoding && root.controls-enabled; min-width: 100px; tooltip-text: strings.tip-start; clicked => { root.start-encode(); } }
            Button { text: strings.button-stop; enabled: root.encoding; min-width: 100px; tooltip-text: strings.tip-stop; clicked => { root.stop-encode(); } }
            ComboBox {
                width: 90px;
                model: ["中文", "English"];
                tooltip-text: strings.tip-language;
                current-index <=> root.language-index;
                selected => { root.language-changed(root.language-index); }
            }
            Button { text: strings.button-about; tooltip-text: strings.tip-about; clicked => { root.show-about(); } }
        }

        } // ---- 主体 VerticalBox 结束 ----
    }
}
