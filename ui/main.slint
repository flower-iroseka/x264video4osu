import { Button, LineEdit, ComboBox, CheckBox, TabWidget, RadioGroup, ListView, Slider, HorizontalBox, VerticalBox, Palette } from "std-widgets.slint";

// FluentMetrics 定义在 fluent-lite/styling.slint，这里再导出一次，Rust 侧才能通过
// crate::FluentMetrics 写它里面的 device-pixel-ratio。
import { FluentMetrics, FluentPalette } from "fluent-lite/styling.slint";
export { FluentMetrics }

// 方形图标按钮（播放控件用的那种）。见 ui/icon-button.slint。
import { IconButton } from "icon-button.slint";

