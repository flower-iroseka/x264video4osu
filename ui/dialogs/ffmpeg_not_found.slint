import { Button, VerticalBox } from "std-widgets.slint";
import { DialogWindow } from "dialog-base.slint";

export component FfmpegNotFoundDialog inherits DialogWindow {
    width: 460px;
    height: 220px;
    title: root.dialog-title;

    /// 窗口的逻辑尺寸。Rust 侧要在窗口创建**之前**算出摆在哪，那会儿
    /// `Window::size()` 还是 0，得从这个绑定读。
    out property <length> dialog-w: root.width;
    out property <length> dialog-h: root.height;

    in property <string> dialog-title;
    in property <string> message;
    in property <string> download-text;
    in property <string> exit-text;

    callback download();
    callback exit-dialog();

    base := Rectangle {
        width: parent.width;
        height: parent.height;

        VerticalBox {
            y: 0px;
            width: parent.width;
            height: parent.height;
            padding: 20px;
            spacing: 16px;

            Text {
                text: root.message;
                wrap: word-wrap;
            }
            Rectangle { height: 0px; vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                spacing: 12px;
                Button {
                    text: root.download-text;
                    width: 130px;
                    tooltip-text: root.download-text;
                    clicked => { root.download(); }
                }
                Button {
                    text: root.exit-text;
                    width: 130px;
                    tooltip-text: root.exit-text;
                    clicked => { root.exit-dialog(); }
                }
            }
        }
    }
}
