import { Button, VerticalBox } from "std-widgets.slint";
import { DialogWindow } from "dialog-base.slint";

export component AboutDialog inherits DialogWindow {
    width: 440px;
    height: 420px;
    title: root.dialog-title;

    /// 窗口的逻辑尺寸。Rust 侧要在窗口创建**之前**算出摆在哪，那会儿
    /// `Window::size()` 还是 0，得从这个绑定读。
    out property <length> dialog-w: root.width;
    out property <length> dialog-h: root.height;

    in property <string> dialog-title;
    in property <string> description;
    in property <string> version-line;
    in property <string> repository-text;
    in property <string> close-text;

    callback open-repository();
    callback close-dialog();

    base := Rectangle {
        width: parent.width;
        height: parent.height;

        VerticalBox {
            y: 0px;
            width: parent.width;
            height: parent.height;
            padding: 32px;
            spacing: 8px;

            Text {
                text: "x264video4osu";
                font-size: 26px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: root.version-line;
                font-size: 13px;
                // 老版灰
                color: #6B7280;
                horizontal-alignment: center;
            }
            Rectangle { height: 24px; }
            Text {
                text: root.description;
                font-size: 14px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            Rectangle { height: 32px; }
            Button {
                text: root.repository-text;
                tooltip-text: root.repository-text;
                clicked => { root.open-repository(); }
            }
            Rectangle { height: 0px; vertical-stretch: 1; }
            HorizontalLayout {
                alignment: center;
                Button {
                    text: root.close-text;
                    width: 100px;
                    tooltip-text: root.close-text;
                    clicked => { root.close-dialog(); }
                }
            }
        }
    }
}
