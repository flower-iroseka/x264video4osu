import { Button, VerticalBox } from "std-widgets.slint";
import { DialogWindow } from "dialog-base.slint";

// 消息框，布局照 Windows 自带的消息框来：左边一个图标，右边正文，按钮靠右下角。
export component MessageDialog inherits DialogWindow {
    dialog-background: #FFFFFF;
    width: 420px;
    // 高度贴合内容。窗口宽度是固定的，正文换行结果就是确定的，所以布局的
    // preferred-height 算得出来。中英文正文行数不一样，各自得到正好的高度，
    // 不用按语言分别写死一个数值。
    height: content.preferred-height;
    title: root.dialog-title;

    in property <string> dialog-title;
    /// 窗口的逻辑尺寸。Rust 侧要在窗口创建**之前**算出摆在哪，那会儿
    /// `Window::size()` 还是 0，得从这个绑定读。
    out property <length> dialog-w: root.width;
    out property <length> dialog-h: root.height;

    in property <string> message;
    in property <string> ok-text;
    /// 第二个按钮的文案；空串表示只显示一个按钮
    in property <string> alt-text;
    /// 左侧图标：none / info / warning / error
    in property <string> icon-kind: "none";

    callback ok();
    callback alt();

    content := VerticalBox {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 12px;
        // 正文和按钮之间的空当
        spacing: 16px;

        HorizontalLayout {
            spacing: 12px;

            if root.icon-kind != "none" : Image {
                width: 32px;
                height: 32px;
                image-fit: contain;
                source: root.icon-kind == "warning" ? @image-url("message-warning.svg")
                      : root.icon-kind == "error" ? @image-url("message-error.svg")
                      : @image-url("message-info.svg");
            }

            Text {
                text: root.message;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: top;
                // 跟按钮和主界面上的文字一样大，默认的 14px 在这个尺寸的消息框里偏大
                font-size: 12px;
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: root.ok-text;
                height: 32px;
                min-width: 96px;
                primary: true;
                tooltip-text: root.ok-text;
                clicked => { root.ok(); }
            }
            if root.alt-text != "" : Button {
                text: root.alt-text;
                height: 32px;
                min-width: 96px;
                tooltip-text: root.alt-text;
                clicked => { root.alt(); }
            }
        }
    }
}
